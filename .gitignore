# Build output
build/

# Odin / MSVC artifacts outside build/
*.exe
*.dll
*.pdb
*.lib
*.exp
*.ilk
*.obj

# Prebuilt libraries of vendored third-party code are part of the source tree.
!src/third_party/**/*.lib
!src/third_party/**/*.a

# Editors
.vscode/
.idea/
*.swp
.DS_Store

# Screenshots saved when the engine runs from the repository root
/screenshot.bmp
